/* SQE1 progress feed for Monnie (21 Nov 2026).
   Layla's revision site posts a progress summary here; Monnie opens the web app link with her read key to see it.
   Storage: this script's own properties only (no access to anything else in the Google account). */
var WRITE_TOK = "__FEED_TOK__";
var READ_KEY = "__READ_KEY__";
var CHUNK = 8000, MAX_DEVS = 6;

function props_(){ return PropertiesService.getScriptProperties(); }
function putBig_(p, key, str){
  var old = +(p.getProperty(key + ":n") || 0), n = Math.ceil(str.length / CHUNK), o = {};
  for (var i = 0; i < n; i++) o[key + ":" + i] = str.slice(i * CHUNK, (i + 1) * CHUNK);
  o[key + ":n"] = String(n);
  p.setProperties(o, false);
  for (var j = n; j < old; j++) p.deleteProperty(key + ":" + j);
}
function getBig_(p, key){
  var n = +(p.getProperty(key + ":n") || 0), s = "";
  for (var i = 0; i < n; i++) s += p.getProperty(key + ":" + i) || "";
  return s;
}
function delBig_(p, key){
  var n = +(p.getProperty(key + ":n") || 0);
  for (var i = 0; i < n; i++) p.deleteProperty(key + ":" + i);
  p.deleteProperty(key + ":n");
}
var SYNC_CODES = {"__SYNC_CODE__": "layla"};
function gz_(s){ return Utilities.base64Encode(Utilities.gzip(Utilities.newBlob(s, "application/json")).getBytes()); }
function ungz_(b){ return Utilities.ungzip(Utilities.newBlob(Utilities.base64Decode(b), "application/x-gzip")).getDataAsString(); }
function acctGet_(p, code){ var b = getBig_(p, "acct:" + code); return b ? ungz_(b) : ""; }
function anyAcct_(p){ for (var c in SYNC_CODES) if (p.getProperty("acctrev:" + c)) return c; return ""; }
function devs_(p){ try { return JSON.parse(p.getProperty("devs") || "[]"); } catch(e){ return []; } }

function doPost(e){
  var lock = LockService.getScriptLock();
  try {
    var body = JSON.parse(e.postData.contents);
    if (body.sync){ /* Layla's shared save: write only if nobody else wrote since she read it */
      if (body.tok !== WRITE_TOK || !SYNC_CODES[body.sync] || typeof body.save !== "string") return json_({ok:false});
      lock.waitLock(20000);
      var ps = props_(), cur = +(ps.getProperty("acctrev:" + body.sync) || 0);
      if (+body.rev !== cur) return json_({ok:false, conflict:true, rev:cur});
      putBig_(ps, "acct:" + body.sync, gz_(body.save));
      ps.setProperty("acctrev:" + body.sync, String(cur + 1)); ps.setProperty("acctat:" + body.sync, String(Date.now()));
      return json_({ok:true, rev:cur + 1});
    }
    if (body.tok !== WRITE_TOK || !body.sum) return ContentService.createTextOutput("no");
    var dev = String(body.dev || "unknown").replace(/[^a-z0-9]/gi, "").slice(0, 40) || "unknown";
    lock.waitLock(20000);
    var p = props_(), ds = devs_(p), now = Date.now(), me = null;
    ds.forEach(function(d){ if (d.id === dev) me = d; });
    if (!me){ me = {id:dev, first:now}; ds.push(me); }
    me.last = now; me.app = body.sum.app === "pocket" ? "pocket" : "laptop";
    var subs = body.sum.subjects || [];
    me.topics = subs.reduce(function(a, s){ return a + (+s.done || 0); }, 0);
    ds.sort(function(a, b){ return b.last - a.last; });
    /* never evict the latest laptop or the latest phone; drop the oldest of the rest */
    while (ds.length > MAX_DEVS){
      var keep = {}, seenApp = {};
      var most = null; ds.forEach(function(d){ var a = d.app || "laptop"; if (!seenApp[a]){ seenApp[a] = 1; keep[d.id] = 1; } if (a === "laptop" && (!most || (d.topics || 0) > (most.topics || 0))) most = d; });
      if (most) keep[most.id] = 1; /* and the laptop with the most progress (Layla's) */
      var gi = -1; for (var x = ds.length - 1; x >= 0; x--) if (!keep[ds[x].id]){ gi = x; break; }
      if (gi < 0) break;
      var gone = ds.splice(gi, 1)[0]; delBig_(p, "sum:" + gone.id); delBig_(p, "save:" + gone.id);
    }
    p.setProperty("devs", JSON.stringify(ds));
    putBig_(p, "sum:" + dev, JSON.stringify(body.sum));
    if (body.save && !anyAcct_(p)){ try { putBig_(p, "save:" + dev, String(body.save)); } catch(e2){ delBig_(p, "save:" + dev); } }
    return ContentService.createTextOutput("ok");
  } catch(err){
    return ContentService.createTextOutput("err");
  } finally { try { lock.releaseLock(); } catch(e3){} }
}

function json_(o){ return ContentService.createTextOutput(JSON.stringify(o)).setMimeType(ContentService.MimeType.JSON); }
function sumOf_(p, id){ try { return JSON.parse(getBig_(p, "sum:" + id) || "null"); } catch(e){ return null; } }
function doGet(e){
  var q = (e && e.parameter) || {};
  if (q.sync === "1"){
    if (!SYNC_CODES[q.c]) return json_({ok:false});
    var pz = props_();
    return json_({ok:true, rev:+(pz.getProperty("acctrev:" + q.c) || 0), save:acctGet_(pz, q.c) || null});
  }
  if (q.pull === "1"){ /* minimal read for Layla's own apps (laptop site / phone app), guarded by the write token */
    if (q.t !== WRITE_TOK) return json_({ok:false});
    var pp = props_(), dd = devs_(pp), lapD = null, out = {ok:true, lap:null, pocket:[]};
    dd.forEach(function(d){ if ((d.app || "laptop") === "laptop" && (!lapD || (d.topics || 0) > (lapD.topics || 0) || ((d.topics || 0) === (lapD.topics || 0) && d.last > lapD.last))) lapD = d; });
    if (lapD){ var ls = sumOf_(pp, lapD.id), done = {}; if (ls) (ls.subjects || []).forEach(function(s){ (s.topics || []).forEach(function(t){ if (t.done) done[s.id + "/" + t.id] = {conf:t.conf != null ? t.conf : null, at:t.at || 0}; }); }); out.lap = {at:lapD.last, done:done, coins:ls && ls.coins != null ? ls.coins : null, pocketTaken:ls && ls.pocketTaken ? ls.pocketTaken : {}}; }
    dd.forEach(function(d){ if (d.app === "pocket"){ var ps = sumOf_(pp, d.id); out.pocket.push({dev:d.id, last:d.last, logs:ps ? ps.logs || [] : [], ans:ps && ps.pocket ? ps.pocket.ans || [] : [], coinsEarned:ps ? +ps.coinsEarned || 0 : 0}); } });
    return json_(out);
  }
  if (q.k !== READ_KEY) return HtmlService.createHtmlOutput("<p style='font-family:sans-serif'>Nothing here.</p>");
  var p = props_(), ds = devs_(p);
  var want = q.dev ? String(q.dev) : "";
  var laps = ds.filter(function(d){ return (d.app || "laptop") === "laptop"; });
  if (!want && laps.length){ /* default: the laptop with the most progress, then the latest */
    var best = laps.slice().sort(function(a, b){ return (b.topics || 0) - (a.topics || 0) || b.last - a.last; })[0]; want = best.id;
  }
  if (q.backup === "1"){
    var ac = anyAcct_(p), sv = (ac && !q.dev ? acctGet_(p, ac) : "") || getBig_(p, "save:" + want) || "{}";
    return ContentService.createTextOutput(sv).setMimeType(ContentService.MimeType.JSON).downloadAsFile("layla-sqe1-backup.json");
  }
  var sum = getBig_(p, "sum:" + want) || "null";
  var pockets = ds.filter(function(d){ return d.app === "pocket"; }).map(function(d){ return {dev:d.id, last:d.last, sum:sumOf_(p, d.id)}; });
  var data = {devs:laps, pockets:pockets, dev:want, sum:JSON.parse(sum), hasSave:!!(p.getProperty("save:" + want + ":n") || anyAcct_(p)), synced:(function(){ var ac = anyAcct_(p); return ac ? +(p.getProperty("acctat:" + ac) || 0) : 0; })(), url:ScriptApp.getService().getUrl(), k:READ_KEY};
  if (q.json === "1") return json_(data); /* for the viewer page on GitHub Pages (works whatever Google accounts the browser is signed into) */
  var html = HtmlService.createHtmlOutput(PAGE.split("<?!= dataJson ?>").join(JSON.stringify(data).replace(/</g, "\\u003c")));
  return html.setTitle("Layla's progress").addMetaTag("viewport", "width=device-width, initial-scale=1");
}

function clearTestDevice(){ var p = props_(), ds = devs_(p).filter(function(d){ return !/^qatest/.test(d.id); }); p.setProperty("devs", JSON.stringify(ds)); ['qatest','qatestp'].forEach(function(x){ delBig_(p, "sum:" + x); delBig_(p, "save:" + x); }); }

var PAGE = "<!DOCTYPE html>\n<html>\n<head>\n<base target=\"_top\">\n<style>\n:root{--bg:#fbf8f3;--card:#fff;--ink:#2b2b2b;--mut:#6b6b6b;--line:#e7e1d8;--acc:#3f6fd8;--good:#2e9d4a;--warn:#e6a000;--bad:#d64541;--est:#b9a37a}\n*{box-sizing:border-box}\nbody{margin:0;background:var(--bg);color:var(--ink);font:16px/1.45 Calibri,Carlito,\"Segoe UI\",Arial,sans-serif}\n.wrap{max-width:980px;margin:0 auto;padding:18px 16px 60px}\nh1{font-size:28px;margin:4px 0 2px}\nh2{font-size:20px;margin:26px 0 10px}\n.mut{color:var(--mut)}.small{font-size:14px}\n.tiles{display:grid;grid-template-columns:repeat(auto-fill,minmax(150px,1fr));gap:10px;margin-top:14px}\n.tile{background:var(--card);border:1px solid var(--line);border-radius:12px;padding:12px 14px}\n.tile b{display:block;font-size:26px;line-height:1.1}\n.tile span{font-size:14px;color:var(--mut)}\n.card{background:var(--card);border:1px solid var(--line);border-radius:12px;padding:14px 16px;margin-bottom:10px}\ntable{width:100%;border-collapse:collapse;font-size:15px}\nth,td{text-align:left;padding:6px 8px;border-bottom:1px solid var(--line);vertical-align:top}\nth{font-weight:600;color:var(--mut);font-size:14px}\ntd.n,th.n{text-align:right;white-space:nowrap}\n.tag{display:inline-block;font-size:12px;padding:1px 7px;border-radius:9px;background:#f1ebe0;color:#7a6440;margin-left:6px}\n.bar{height:10px;background:#efe9df;border-radius:6px;overflow:hidden;display:flex;min-width:80px}\n.bar i{display:block;height:100%}\n.dot{display:inline-block;width:12px;height:12px;border-radius:50%;vertical-align:-1px;margin-right:4px;border:1px solid rgba(0,0,0,.25)}\ndetails{margin:0}summary{cursor:pointer;list-style:none;display:flex;gap:10px;align-items:center;flex-wrap:wrap}\nsummary::-webkit-details-marker{display:none}\nsummary .t{font-weight:600;flex:1 1 220px}\n.steps span{display:inline-block;font-size:12px;padding:1px 7px;border-radius:9px;margin:2px 3px 0 0;background:#e9f4ec;color:#21733a}\n.steps span.no{background:#f3f0ea;color:#a39a8a}\n.scroll{overflow-x:auto}\ntd.small{min-width:240px}\nselect,a.btn{font:inherit;font-size:15px;padding:6px 10px;border:1px solid var(--line);border-radius:8px;background:#fff;color:var(--ink);text-decoration:none}\n.note{background:#fff7e3;border:1px solid #f0dca8;border-radius:10px;padding:10px 12px;font-size:15px;margin-top:12px}\n</style>\n</head>\n<body><div class=\"wrap\" id=\"app\"></div>\n<script>\nvar D = <?!= dataJson ?>;\nvar S = D.sum, app = document.getElementById(\"app\");\n/* phone app (pocket) data is added into the laptop view: time per day/subject and questions */\nvar PH = {logs:[], ans:[], last:0, quickN:0, cardsN:0, bySub:{}};\n(D.pockets || []).forEach(function(pk){ var s = pk.sum; if (!s) return; PH.last = Math.max(PH.last, pk.last || 0);\n  (s.logs || []).forEach(function(l){ PH.logs.push({d:l.d, m:+l.m || 0, s:l.s || \"\", kind:\"phone\"}); });\n  ((s.pocket || {}).ans || []).forEach(function(a){ PH.ans.push(a); });\n  PH.quickN += +s.quickN || 0; PH.cardsN += +s.cardsN || 0;\n  (s.subjects || []).forEach(function(x){ var z = PH.bySub[x.id] = PH.bySub[x.id] || {n:0, r:0}; z.n += +x.qTried || 0; z.r += +x.qRight || 0; }); });\nfunction esc(s){ return String(s == null ? \"\" : s).replace(/[&<>\"']/g, function(c){ return {\"&\":\"&amp;\",\"<\":\"&lt;\",\">\":\"&gt;\",'\"':\"&quot;\",\"'\":\"&#39;\"}[c]; }); }\nfunction when(ms){ if (!ms) return \"never\"; return new Date(ms).toLocaleString(\"en-GB\", {timeZone:\"Europe/London\", weekday:\"short\", day:\"numeric\", month:\"short\", hour:\"numeric\", minute:\"2-digit\"}); }\nfunction dayName(d){ var p = d.split(\"-\"); return new Date(Date.UTC(+p[0], +p[1] - 1, +p[2], 12)).toLocaleDateString(\"en-GB\", {timeZone:\"UTC\", weekday:\"short\", day:\"numeric\", month:\"short\"}); }\nfunction hm(m){ m = Math.round(m || 0); if (!m) return \"0m\"; var h = Math.floor(m / 60), r = m % 60; return (h ? h + \"h \" : \"\") + (r ? r + \"m\" : \"\").trim(); }\nfunction londonYmd(ms){ return new Date(ms).toLocaleDateString(\"en-CA\", {timeZone:\"Europe/London\"}); }\nvar CONF = {\"1\":[\"Green\",\"var(--good)\"], \"0.5\":[\"Amber\",\"var(--warn)\"], \"0\":[\"Red\",\"var(--bad)\"]};\nvar STEP = {notes:\"Room / notes\", quick:\"Quick fire\", qa:\"Model Q&A\", bert:\"Bert\", rate:\"Rated\"};\nfunction render(){\n  var h = '<h1>Layla\u2019s SQE1 progress</h1>';\n  if (!S){ app.innerHTML = h + '<p class=\"mut\">Nothing has come in yet. Her site sends an update a few seconds after she opens it, then every few minutes while she studies.</p>'; return; }\n  h += '<div class=\"mut small\">Last update from her laptop: <b>' + esc(when(S.sentAt)) + '</b> \u00b7 last saved progress: ' + esc(when(S.savedAt)) + '</div>';\n  if (D.devs.length > 1){\n    h += '<div style=\"margin-top:10px\" class=\"small\">Device: <select id=\"dev\">' + D.devs.map(function(d){ return '<option value=\"' + esc(d.id) + '\"' + (d.id === D.dev ? \" selected\" : \"\") + '>' + esc((d.topics || 0) + ((d.topics === 1) ? \" topic\" : \" topics\") + \", last seen \" + when(d.last)) + '</option>'; }).join(\"\") + '</select></div>';\n  }\n  var subs = S.subjects || [], tAll = 0, tDone = 0, qT = 0, qR = 0, red = 0, amb = 0, grn = 0, bertW = Object.keys((S.bert || {}).won || {}).length;\n  Object.keys(PH.bySub).forEach(function(k){ qT += PH.bySub[k].n; qR += PH.bySub[k].r; });\n  subs.forEach(function(s){ tAll += s.n; tDone += s.done; qT += s.qTried; qR += s.qRight; s.topics.forEach(function(t){ if (t.conf === 1) grn++; else if (t.conf === 0.5) amb++; else if (t.conf === 0) red++; }); });\n  var logs = (S.logs || []).concat(PH.logs), byDay = {}, tot = {auto:0, est:0, timer:0, phone:0};\n  logs.forEach(function(l){ var z = byDay[l.d] = byDay[l.d] || {auto:0, est:0, timer:0, phone:0, subj:{}}; z[l.kind] = (z[l.kind] || 0) + l.m; tot[l.kind] = (tot[l.kind] || 0) + l.m; if (l.s) z.subj[l.s] = (z.subj[l.s] || 0) + l.m; });\n  var today = londonYmd(Date.now()), fedToday = (S.fed || []).indexOf(today) >= 0, cl = S.cloud || {};\n  h += '<div class=\"tiles\">' +\n    '<div class=\"tile\"><b>' + tDone + '<small style=\"font-size:16px;color:var(--mut)\"> / ' + tAll + '</small></b><span>topics covered</span></div>' +\n    '<div class=\"tile\"><b>' + hm(tot.auto + tot.est + tot.timer + tot.phone) + '</b><span>study time in total' + (tot.est ? ' (' + hm(tot.est) + ' estimated)' : '') + (tot.phone ? ' (' + hm(tot.phone) + ' on her phone)' : '') + '</span></div>' +\n    '<div class=\"tile\"><b>' + qT + '</b><span>questions answered' + (qT ? ', ' + Math.round(qR * 100 / qT) + '% right' : '') + '</span></div>' +\n    '<div class=\"tile\"><b>' + bertW + '</b><span>Bert games won</span></div>' +\n    '<div class=\"tile\"><b>' + (S.coins != null ? S.coins : \"?\") + '</b><span>coins now</span></div>' +\n    '<div class=\"tile\"><b>' + (cl.step != null ? cl.step + ' / ' + cl.of : \"?\") + '</b><span>cloud step (days in a row)</span></div>' +\n    '<div class=\"tile\"><b><span class=\"dot\" style=\"background:var(--good)\"></span>' + grn + ' <span class=\"dot\" style=\"background:var(--warn)\"></span>' + amb + ' <span class=\"dot\" style=\"background:var(--bad)\"></span>' + red + '</b><span>her green / amber / red ratings</span></div>' +\n    '<div class=\"tile\"><b>' + (fedToday ? \"Yes\" : \"Not yet\") + '</b><span>Britney fed today' + (S.ill ? \" \u00b7 Britney is ill\" : \"\") + '</span></div>' +\n  '</div>';\n  if (S.bert && S.bert.cap) h += '<div class=\"note\">Bert has Britney at the moment (since ' + esc(dayName(S.bert.cap.from)) + ', ' + S.bert.cap.tries + ' rescue tries' + (S.bert.cap.ransom ? ', ransom stage' : '') + ').</div>';\n\n  /* ---- days ---- */\n  var days = {}; Object.keys(byDay).forEach(function(d){ days[d] = 1; });\n  var qa = JSON.parse(JSON.stringify(S.qa || {}));\n  PH.ans.forEach(function(a){ if (!a.at) return; var d = londonYmd(a.at), z = qa[d] = qa[d] || {n:0, r:0}; z.n++; if (a.ok) z.r++; });\n  Object.keys(qa).forEach(function(d){ days[d] = 1; });\n  var stepsDay = {}, ratedDay = {};\n  subs.forEach(function(s){ s.topics.forEach(function(t){\n    for (var k in t.steps){ var ts = t.steps[k]; if (ts > 1.6e12){ var d = londonYmd(ts); days[d] = 1; (stepsDay[d] = stepsDay[d] || []).push(s.title + \" \" + t.i + \": \" + (STEP[k] || k)); } }\n    if (t.at && t.conf != null){ var d2 = londonYmd(t.at); days[d2] = 1; ratedDay[d2] = (ratedDay[d2] || 0) + 1; }\n  }); });\n  var dl = Object.keys(days).sort().reverse();\n  h += '<h2>Day by day</h2><div class=\"card scroll\"><table><tr><th>Day</th><th class=\"n\">Time</th><th class=\"n\">Steps done</th><th class=\"n\">Questions</th><th class=\"n\">Rated</th><th>What she did</th></tr>';\n  dl.forEach(function(d){\n    var z = byDay[d] || {auto:0, est:0, timer:0, phone:0, subj:{}}, m = z.auto + z.est + z.timer + z.phone, q = qa[d], st = stepsDay[d] || [];\n    var tag = (z.est && !z.auto ? '<span class=\"tag\">estimated</span>' : z.est ? '<span class=\"tag\">part estimated</span>' : '') + (z.phone ? '<span class=\"tag\">' + hm(z.phone) + ' phone</span>' : '');\n    h += '<tr><td style=\"white-space:nowrap\">' + esc(dayName(d)) + '</td><td class=\"n\">' + hm(m) + tag + '</td><td class=\"n\">' + st.length + '</td><td class=\"n\">' + (q ? q.n + ' (' + Math.round(q.r * 100 / q.n) + '% right)' : '0') + '</td><td class=\"n\">' + (ratedDay[d] || 0) + '</td><td class=\"small\">' + esc(st.slice(0, 12).join(\" \u00b7 \")) + (st.length > 12 ? ' \u2026' : '') + '</td></tr>';\n  });\n  if (!dl.length) h += '<tr><td colspan=\"6\" class=\"mut\">Nothing yet.</td></tr>';\n  h += '</table><div class=\"small mut\" style=\"margin-top:8px\">\u201cEstimated\u201d time comes from the steps she ticked (each step\u2019s planned time). That is all there is for Friday 20 Nov, before automatic counting started. Since then, time is counted automatically while she is actually using a study page.</div></div>';\n\n  /* ---- time by subject ---- */\n  var bySub = {}; logs.forEach(function(l){ var k = l.s || \"\"; var z = bySub[k] = bySub[k] || {auto:0, est:0, timer:0, phone:0}; z[l.kind] += l.m; });\n  var subTitle = {}; subs.forEach(function(s){ subTitle[s.id] = s.title; });\n  var sk = Object.keys(bySub).sort(function(a, b){ var A = bySub[a], B = bySub[b]; return (B.auto + B.est + B.timer + B.phone) - (A.auto + A.est + A.timer + A.phone); });\n  if (sk.length){\n    h += '<h2>Time by subject</h2><div class=\"card scroll\"><table><tr><th>Subject</th><th class=\"n\">Counted automatically</th><th class=\"n\">Estimated</th><th class=\"n\">Timer / added</th>' + (tot.phone ? '<th class=\"n\">Phone</th>' : '') + '<th class=\"n\">Total</th></tr>';\n    sk.forEach(function(k){ var z = bySub[k]; h += '<tr><td>' + esc(subTitle[k] || (k ? k : \"Games and mixed practice\")) + '</td><td class=\"n\">' + hm(z.auto) + '</td><td class=\"n\">' + hm(z.est) + '</td><td class=\"n\">' + hm(z.timer) + '</td>' + (tot.phone ? '<td class=\"n\">' + hm(z.phone) + '</td>' : '') + '<td class=\"n\"><b>' + hm(z.auto + z.est + z.timer + z.phone) + '</b></td></tr>'; });\n    h += '</table></div>';\n  }\n\n  /* ---- subjects ---- */\n  h += '<h2>Subjects</h2>';\n  subs.forEach(function(s){\n    var g = 0, a = 0, r = 0, o = 0; s.topics.forEach(function(t){ if (t.conf === 1) g++; else if (t.conf === 0.5) a++; else if (t.conf === 0) r++; else if (t.done) o++; });\n    var w = function(n, c){ return n ? '<i style=\"width:' + (n * 100 / s.n) + '%;background:' + c + '\"></i>' : ''; };\n    h += '<div class=\"card\"><details' + (s.topics.length ? '' : '') + '><summary><span class=\"t\">' + esc(s.title) + '</span><span class=\"small mut\">' + s.done + ' of ' + s.n + ' topics' + (function(){ var ph = PH.bySub[s.id] || {n:0, r:0}, n = s.qTried + ph.n, r = s.qRight + ph.r; return n ? ' \u00b7 ' + n + ' questions, ' + Math.round(r * 100 / n) + '% right' + (ph.n ? ' (' + ph.n + ' on phone)' : '') : ''; })() + '</span><span class=\"bar\" style=\"flex:0 0 140px\">' + w(g, \"var(--good)\") + w(a, \"var(--warn)\") + w(r, \"var(--bad)